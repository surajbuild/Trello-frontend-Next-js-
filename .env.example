# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Secret used to sign auth JWTs. Override with a long random value in production.
AUTH_SECRET=dev-secret-change-in-production

# Resend API key for sending emails (get from https://resend.com)
RESEND_API_KEY=re_your-api-key-here

# App URL used for email verification links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI-compatible chat completion endpoint.
# Leave AI_BASE_URL / AI_API_KEY unset to use the offline fallback assistant.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key-here
# Optional: model name (default gpt-4o-mini)
AI_MODEL=gpt-4o-mini
# Optional: upstream request timeout in milliseconds (default 60000)
AI_TIMEOUT_MS=60000